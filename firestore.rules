rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Patients collection: Patients can manage their own profile; server or authenticated can read
    match /patients/{patientId} {
      allow get: if isSignedIn() && (isOwner(patientId) || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || patientId == request.auth.uid);
      allow update: if isSignedIn() && (isOwner(patientId) || resource.data.uid == request.auth.uid);
      allow delete: if isOwner(patientId);
    }

    // Doctors collection: Anyone can read available doctors, authenticated staff can create/update
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Appointments: Patients can view and book their own appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.patientId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    // Copilot health consultation chat history
    match /copilotMessages/{messageId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
